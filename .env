# Dhan API URLs
DHAN_OPTION_CHAIN_URL=https://api.dhan.co/v2/optionchain
DHAN_EXPIRY_LIST_URL=https://api.dhan.co/v2/optionchain/expirylist

# Optional Client ID (service will auto-extract this from JWT if omitted)
DHAN_CLIENT_ID=1106727953

# Minimum gap in seconds between ANY two API requests (Dhan limit: 1 req per 3 seconds)
# 208 symbols × 3s = ~10.4 min per cycle.
DHAN_RATE_LIMIT_SECONDS=3

# Market Hours Gate (Kolkata time, 24-hour format)
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:40
MARKET_TIMEZONE=Asia/Kolkata

# Manual Expiry Date override (if set, bypasses Expiry List API calls for all symbols)
MARKET_EXPIRY_DATE=2026-08-25

# MongoDB Connection
